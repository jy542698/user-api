# ============================================================
# 配置模板 —— 复制为 application.properties 后填入你自己的值
#   Windows: copy application.properties.example application.properties
#   macOS/Linux: cp application.properties.example application.properties
# 真正的 application.properties 已被 .gitignore 排除，不会进仓库。
# ============================================================
spring.application.name=user-api

# 显式指定端口，避免被环境变量干扰
server.port=8080

# ===== MySQL 连接配置（把密码换成你自己的）=====
spring.datasource.url=jdbc:mysql://localhost:3306/user_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=改成你自己的MySQL密码

# JPA 配置：update = 表不存在就创建，存在就不动数据
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ===== JWT 配置（学习用；正式项目请放到环境变量或配置中心）=====
# 长度至少 32 字符，否则 jjwt 会拒绝签名
app.jwt.secret=请替换为一段足够长的随机字符串至少32字符
app.jwt.expiration=86400000
